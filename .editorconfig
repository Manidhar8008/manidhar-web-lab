# .editorconfig

# EditorConfig helps maintain consistent coding styles
# for multiple developers working on the same project

root = true

# All files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# JavaScript/JSX
[*.{js,jsx,ts,tsx,json}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_size = 2
